digraph "atm_pin_format" {
  rankdir=LR;
  __start [shape=point];
  "s0" [shape=circle];
  "s1" [shape=circle];
  "s2" [shape=circle];
  "s3" [shape=circle];
  "s4" [shape=doublecircle];
  "s5" [shape=circle];
  "s6" [shape=doublecircle];
  __start -> "s0";
  "s0" -> "s1" [label="d"];
  "s1" -> "s2" [label="d"];
  "s2" -> "s3" [label="d"];
  "s3" -> "s4" [label="d"];
  "s4" -> "s5" [label="d"];
  "s5" -> "s6" [label="d"];
}